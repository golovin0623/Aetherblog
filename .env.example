# =============================================================================
# AetherBlog 环境变量模板
# =============================================================================
#
# 使用方式
# ────────
#   1. 本机开发首次启动（推荐）：
#         直接运行 ./start.sh --gateway，脚本会自动 cp 本文件为 .env，
#         并为下方所有 [AUTO-GEN] 标记的字段就地生成强密钥。
#
#   2. 手动准备：
#         cp .env.example .env
#         然后把 [AUTO-GEN] 字段替换为强密钥（命令见各字段下方注释）。
#
# 字段标签解读
# ────────
#   [LOCAL DEV]  本机开发默认值，已对齐 docker-compose.yml 中间件容器配置。
#                直接 cp 即可跑通 ./start.sh / ./start.sh --gateway。
#   [PROD]       生产部署 (docker-compose.prod.yml) 必须重写为生产值。
#   [AUTO-GEN]   start.sh 在 .env 不存在或字段为空时会自动生成，无需手填。
#                也可手动用注释里的命令生成。
#
# =============================================================================

# --- Gateway ---
GATEWAY_PORT=7899

# --- PostgreSQL ---
# [AUTO-GEN] 缺失时由 start.sh 自动生成强随机值
# [PROD]      生产必须显式设置并妥善保管，不得使用示例或弱口令
POSTGRES_PASSWORD=

# --- Redis ---
# [LOCAL DEV] localhost 直连本机映射端口
# [AUTO-GEN] REDIS_PASSWORD 缺失时由 start.sh 自动生成强随机值
# [PROD]      REDIS_HOST 改回服务名 "redis"，并使用强随机密码
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (REQUIRED, min 32 chars) ---
# [AUTO-GEN] start.sh 会用 openssl rand -base64 48 生成
# 手动生成：openssl rand -base64 48
JWT_SECRET=

# --- Auth Cookie ---
# [PROD]      生产 HTTPS 必须为 true
# [LOCAL DEV] 如需本机 HTTP 调试登录，可手动改为 false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict

# --- CORS ---
# [LOCAL DEV] 网关端口 7899 + Vite admin 5173 + Next blog 3000
# [PROD]      改为实际域名（含 https://）
CORS_ALLOWED_ORIGINS=http://localhost:7899,http://127.0.0.1:7899,http://localhost:5173,http://localhost:3000

# --- Internal Service Token (REQUIRED, min 32 chars) ---
# Go 后端 ↔ AI 服务的内部认证令牌；两个变量必须取相同值。
# [AUTO-GEN] start.sh 会用 openssl rand -base64 48 生成同一份值同时写入两个变量
# 手动生成：openssl rand -base64 48
AETHERBLOG_AI_INTERNAL_SERVICE_TOKEN=
AI_INTERNAL_SERVICE_TOKEN=

# --- AI Credential Encryption Keys (REQUIRED) ---
# Fernet 密钥，用于加密用户提交的 AI provider API Key。
# 多 key 用逗号分隔以支持零停机轮换：第一个用于新加密，全部用于解密。
# VULN-056：禁止复用 JWT_SECRET。
# [AUTO-GEN] start.sh 会用 cryptography Fernet 自动生成
# 手动生成：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIAL_ENCRYPTION_KEYS=

# --- AI Service ---
# 留空则使用 mock provider，所有 AI 工具会返回桩响应；填入后启用真实 LLM。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_MOCK_MODE=false

# --- Logging ---
# 启动时的最低日志级别(进程重启回到这里的值)。
# 运行时可经 PUT /v1/admin/system/log-level 在线调整,无需重启。
# backend (Go zerolog): debug | info | warn | error
# ai-service (Python logging): debug | info | warning | error | critical
# 默认 info —— docker healthcheck 每 3 秒探活一次,降到 debug 会瞬间淹没业务日志。
# AETHERBLOG_LOG_LEVEL=info
# AI_LOG_LEVEL=info

# --- SSRF Guard (LOCAL DEV ONLY — MUST remain unset in production) ---
# Local development behind a fake-ip proxy (Clash/Mihomo default
# fake-ip-range: 198.18.0.0/16) resolves public hostnames to 198.18.x,
# which Python's stdlib classifies as private/reserved. The SSRF guard
# in ai-service then rejects the outbound LLM call as "Provider base_url
# resolves to an internal or private network".
#
# Setting this to 1 drops the broad is_private/is_reserved heuristic and
# relies only on the explicit blocklist (RFC1918, loopback, link-local
# incl. AWS/GCP/Azure IMDS, CGNAT, v6 ULA — still fully enforced).
# AETHERBLOG_SSRF_ALLOW_RESERVED=1

# --- Self-hosted LLM (Ollama / vLLM / 内网 LLM 网关) ---
# 当 provider 的 base_url 指向本机或局域网的自托管 LLM 时（典型场景:
# http://127.0.0.1:11434/v1   <- 主机上的 Ollama
# http://ollama:11434/v1      <- 同一 docker 网络下的容器名
# http://10.0.0.5:4000/v1     <- 公司内网 LiteLLM 代理
# 默认 SSRF guard 会以 "Blocked: base_url resolves to a private/internal
# network" 拒绝。把下面这一行打开放行 RFC1918 + loopback + IPv6 ULA。
#
# 仍然永远硬拒:IMDS (169.254/16) / CGNAT (100.64/10) / 0.0.0.0/8 / 广播,
# 这些目标在任何 LLM 场景下都不应是合法 endpoint。
#
# 威胁模型:打开此开关意味着信任 admin 不会被攻陷后用来攻击同网段其它
# 内部服务。把 ai-service 部署在独立网段 / 命名空间能进一步缩小 blast
# radius。生产环境只在确实需要内网 LLM 时启用。
# AETHERBLOG_AI_ALLOW_INTERNAL_LLM=1

# --- 对象存储 (Object Storage) ---
# 后端默认使用 LOCAL 存储(./uploads),要切到 S3/COS/OSS/MinIO/R2:
#   1. 进 admin 后台 /settings → "存储管理" tab → 添加云 provider 并填好 bucket / region / accessKeyId / secretAccessKey;
#   2. 点 "测试连接" 确认 HeadBucket 通,再点 "设为默认";
#   3. 之后新上传的文件自动入云,媒体记录的 storageType / cdnUrl 同步落库。
#
# 存量本地文件镜像备份到云:
#   - 媒体页右上角"备份到云"按钮 → 选目标 provider → 立即备份未关联文件;
#   - 失败任务可在抽屉里逐条重试;后端 max_attempt=3 后自动放弃。
#
# 自动后台备份(后台 ticker 周期拣 PENDING):
#   - 默认关闭,避免存量切云时一次性灌爆 bucket 产生意外费用;
#   - 要打开,在 site_settings 把 storage.sync.auto_enabled 设为 true。
#
# 反向管理(admin 看见云端,导入孤儿文件 / 删除孤儿):
#   - admin 侧栏 → "云端浏览" → 选 provider 查 bucket 内容;
#   - 已入库的 key 显示 ✓ 已入库,catalog 之外的显示 ⚠ 孤儿,可批量导入或删除。
#
# 安全:secretAccessKey 落库前会被 Fernet 加密(复用 AI_CREDENTIAL_ENCRYPTION_KEYS,
# 与 ai-service 共享密钥)。启动时若检测到 legacy 明文行,自动加密重写为 enc:v1: 形态。
# 没配 AI_CREDENTIAL_ENCRYPTION_KEYS 时退化为透传(开发模式),不阻塞 startup。
# 自动后台备份开关由 site_settings.storage.sync.auto_enabled 控制,UI 在 设置 → 存储管理。
# AETHERBLOG_SYNC_AUTO_ENABLED=false        # 兜底默认值,site_settings 优先
# AETHERBLOG_SYNC_BATCH_SIZE=50
# AETHERBLOG_SYNC_RATE_PER_SECOND=5
# AETHERBLOG_SYNC_CONCURRENCY=3
# AETHERBLOG_SYNC_MAX_ATTEMPT=3
# AETHERBLOG_SYNC_POLL_INTERVAL_SEC=10

# --- Docker Registry (for pulling pre-built images) ---
# DOCKER_REGISTRY=golovin0623
# VERSION=latest

# --- Container Monitoring (admin panel "容器监控") ---
# The backend container mounts /var/run/docker.sock:ro to read container
# stats for the admin monitor page. The process runs as UID 1001 (non-root),
# so it must be added to the host's docker group via group_add. Set this to
# the GID of the host's `docker` group; find it with:
#   stat -c '%g' /var/run/docker.sock
# Typical values: 999 (Ubuntu/Debian), 998 (some distros), 281 (Alpine).
# If unset, docker-compose defaults to 999.
DOCKER_GID=999
