[Unit]
Description=AetherBlog Deployment Webhook Service
After=network.target

# ============================================================================
# 部署形态：unprivileged user + 127.0.0.1 + systemd hardening
#
# 系统要求（硬性）：
#   - systemd >= 235 (2017-10): 用到 LockPersonality / LogsDirectory /
#     RuntimeDirectory, 三者都是 235 引入. CentOS 7 / RHEL 7 (systemd 219)
#     不支持本 unit, 老主机请直跑 python3 webhook_server.py 走 fallback
#     路径, 见 ops/webhook/README.md "systemd < 235 主机" 段.
#   - 现代主流发行版均覆盖: RHEL/CentOS 8 (239), Ubuntu 18.04+ (237+),
#     Debian 10+ (241), Ubuntu 20.04+ (245).
#
# 关键约束（PR #459 / #586 / #587 的产物，落地前先看 ops/webhook/README.md）：
#   - User/Group=webhook：无特权账号，需在安装前 useradd 创建。
#   - WorkingDirectory + ReadWritePaths 集中在 /var/lib/aetherblog/，
#     ProtectHome=true 会**屏蔽 /root**——仓库不能再放在 /root/Aetherblog。
#   - PROJECT_DIR 默认指向 /var/lib/aetherblog/Aetherblog；如果你的 git
#     工作树在别处，覆盖 PROJECT_DIR 并把路径加到 ReadWritePaths。
#   - WEBHOOK_BIND=127.0.0.1：仅本机监听，外部访问走 nginx/反代前置。
#   - WEBHOOK_SECRET 由 EnvironmentFile=/etc/aetherblog/webhook.env 注入，
#     不再内联到 world-readable unit 文件。
# ============================================================================

[Service]
Type=simple
User=webhook
Group=webhook
WorkingDirectory=/var/lib/aetherblog/webhook

EnvironmentFile=-/etc/aetherblog/webhook.env

Environment=WEBHOOK_PORT=7868
Environment=WEBHOOK_BIND=127.0.0.1
Environment=DEPLOY_SCRIPT=/var/lib/aetherblog/webhook/deploy.sh
Environment=DEPLOY_TIMEOUT=900
# 日志 / 锁文件路径走 systemd LogsDirectory / RuntimeDirectory: 由 systemd
# 在每次启动时按 User/Group 创建 /var/log/aetherblog 与 /run/aetherblog,
# 无特权 webhook 帐号有写权限. deploy.sh 与 webhook_server.py 都尊重这两个
# env override (默认是 /var/log/aetherblog-deploy.log + /var/lock/...).
Environment=LOG_FILE=/var/log/aetherblog/deploy.log
Environment=LOCK_FILE=/run/aetherblog/deploy.lock
# PROJECT_DIR 必须落在 ReadWritePaths 里, 否则 webhook_server.py 的 git
# fetch + reset --hard 会被 ProtectSystem=strict 拒掉. webhook_server.py
# 自己默认是 /root/Aetherblog，但 ProtectHome=true 已经把 /root 屏蔽，
# 所以这里显式覆盖到 /var/lib/ 下。
Environment=PROJECT_DIR=/var/lib/aetherblog/Aetherblog

# PYTHON_BIN 默认走系统 python3, 跟其他发行版的 webhook 部署习惯对齐.
# 任何升级 Python 版本 / 切换发行版的人, 改这一行不动 ExecStart.
# 注意: ProtectHome=true 屏蔽 /root 与 /home, 走 pyenv 的部署需要把解释器
# 放到 /opt 或 /usr/local 下 (例如 /opt/pyenv/versions/3.x.y/bin/python3),
# 或者在 systemctl edit 里同时关闭 ProtectHome.
Environment=PYTHON_BIN=/usr/bin/python3
ExecStart=${PYTHON_BIN} /var/lib/aetherblog/webhook/webhook_server.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# LogsDirectory / RuntimeDirectory 由 systemd 自动以 User/Group 拥有,
# 不需要再加进 ReadWritePaths. 仓库工作树 + webhook 运行目录是另一回事.
LogsDirectory=aetherblog
RuntimeDirectory=aetherblog
ReadWritePaths=/var/lib/aetherblog/webhook /var/lib/aetherblog/Aetherblog
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
