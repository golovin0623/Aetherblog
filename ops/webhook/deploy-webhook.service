[Unit]
Description=AetherBlog Deployment Webhook Service
After=network.target

# ============================================================================
# 安全基线：最小权限 + 本机监听 + 密钥走 EnvironmentFile
#
# - User/Group=webhook 无特权运行
# - 默认监听 127.0.0.1，建议通过反向代理暴露
# - WEBHOOK_SECRET 存放在 /etc/aetherblog/webhook.env，避免写入 unit 文件
# - 启用 systemd sandbox/hardening 指令降低进程逃逸和主机写入面
# ============================================================================

[Service]
Type=simple
User=webhook
Group=webhook
WorkingDirectory=/var/lib/aetherblog/webhook

EnvironmentFile=-/etc/aetherblog/webhook.env

Environment=WEBHOOK_PORT=7868
# WEBHOOK_BIND 默认 127.0.0.1 本机监听; 由 nginx 等反向代理对外暴露.
Environment=WEBHOOK_BIND=127.0.0.1
Environment=WEBHOOK_REQUEST_TIMEOUT=15
Environment=WEBHOOK_MAX_BODY_BYTES=8192
Environment=DEPLOY_SCRIPT=/var/lib/aetherblog/webhook/deploy.sh
Environment=DEPLOY_TIMEOUT=900

# PYTHON_BIN 默认走系统 python3, 跟其他发行版的 webhook 部署习惯对齐.
# 当前生产装了 pyenv, 安装步骤里用 systemctl edit 覆盖成
#   Environment=PYTHON_BIN=/root/.pyenv/versions/3.9.9/bin/python3
# 任何升级 Python 版本 / 切换发行版的人, 改这一行不动 ExecStart.
Environment=PYTHON_BIN=/usr/bin/python3
ExecStart=${PYTHON_BIN} /var/lib/aetherblog/webhook/webhook_server.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aetherblog/webhook /var/lock /var/log
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
